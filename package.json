{
  "name": "deskholt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-test-module-mocks --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "verify:p0-a3:migrations": "tsx scripts/verify-p0-a3-migrations.ts",
    "verify:p0-a3:publishing-concurrency": "tsx scripts/verify-product-publishing-concurrency.ts",
    "verify:p0-a3:cache-runtime": "tsx scripts/verify-product-page-cache-runtime.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.438.0",
    "next": "^16.3.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "schema-dts": "^1.1.2",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.2",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.26",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.5.4"
  }
}
